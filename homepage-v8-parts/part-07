function renderFeatured(){
  const rows=offers.filter(o=>isOffer(o)&&priceOf(o)!=null).sort((a,b)=>savingPct(b)-savingPct(a)||(unitOf(a)??Infinity)-(unitOf(b)??Infinity)).slice(0,4);
