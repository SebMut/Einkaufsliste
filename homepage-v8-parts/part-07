function render(){
  const rows=filterOffers();
  const shown=rows.slice(0,state.visible);
  $('#cards').innerHTML=shown.length?shown.map(cardHtml).join(''):`<div class="empty"><b>Keine passenden Produkte gefunden</b>Versuche einen allgemeineren Suchbegriff oder entferne einen Filter.</div>`;
  $('#status').textContent=state.q?`Treffer für „${state.q}“`:'Lokales Sortiment und aktuelle Angebote';
  $('#resultMeta').textContent=`${rows.length.toLocaleString('de-DE')} Treffer`;
  $('#more').hidden=rows.length<=state.visible;
  $('#more').textContent=`Mehr anzeigen · ${Math.min(rows.length-state.visible,36)} weitere`;
  $$('[data-add]').forEach(b=>b.onclick=()=>toggleList(b.dataset.add));
  $$('[data-history]').forEach(b=>b.onclick=()=>openHistory(b.dataset.history));
}

