    $('#productCount').textContent=offers.length.toLocaleString('de-DE');$('#offerCount').textContent=offers.filter(isOffer).length.toLocaleString('de-DE');$('#storeCount').textContent=new Set(offers.map(o=>o.store).filter(Boolean)).size.toLocaleString('de-DE');
    const generated=data.generatedAt?new Date(data.generatedAt):null;const stamp=generated&&!Number.isNaN(generated.getTime())?generated.toLocaleString('de-DE',{dateStyle:'short',timeStyle:'short'}):'aktuell';
    $('#dataDot').className='dot ok';$('#liveNote').textContent=`Daten aktuell · ${offers.length.toLocaleString('de-DE')} Produkte · Stand ${stamp}`;
    renderChips();renderFeatured();render();
